const canvas = document.getElementById('mobileCanvas');
const ctx = canvas.getContext('2d');

const mapTitle = document.getElementById('mapTitle');
const sessionBadge = document.getElementById('sessionBadge');
const playersList = document.getElementById('playersList');
const markersList = document.getElementById('markersList');
const refreshBtn = document.getElementById('refreshBtn');

async function loadMap() {
  const response = await fetch('/api/maps/fortazan-kudo');
  const data = await response.json();
  mapTitle.textContent = data.name;
  renderMap(data);
  renderPlayers(data.players || []);
  renderMarkers(data.markers || []);
}

function worldToCanvas(x, y) {
  return {
    x: x + canvas.width / 2,
    y: y + canvas.height / 2
  };
}

function renderMap(mapData) {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  const step = mapData.gridSize || 40;
  ctx.strokeStyle = 'rgba(148,163,184,0.12)';
  ctx.lineWidth = 1;

  for (let x = -canvas.width; x < canvas.width * 2; x += step) {
    ctx.beginPath();
    ctx.moveTo(x, 0);
    ctx.lineTo(x, canvas.height);
    ctx.stroke();
  }

  for (let y = -canvas.height; y < canvas.height * 2; y += step) {
    ctx.beginPath();
    ctx.moveTo(0, y);
    ctx.lineTo(canvas.width, y);
    ctx.stroke();
  }

  const objects = [...(mapData.objects || [])].sort((a, b) => (a.z || 0) - (b.z || 0));

  objects.forEach((obj) => {
    if (obj.type === 'rectangle') {
      const p = worldToCanvas(obj.x, obj.y);
      const r = Math.min(obj.cornerRadius || 0, obj.width / 2, obj.height / 2);

      ctx.beginPath();
      ctx.moveTo(p.x + r, p.y);
      ctx.lineTo(p.x + obj.width - r, p.y);
      ctx.quadraticCurveTo(p.x + obj.width, p.y, p.x + obj.width, p.y + r);
      ctx.lineTo(p.x + obj.width, p.y + obj.height - r);
      ctx.quadraticCurveTo(p.x + obj.width, p.y + obj.height, p.x + obj.width - r, p.y + obj.height);
      ctx.lineTo(p.x + r, p.y + obj.height);
      ctx.quadraticCurveTo(p.x, p.y + obj.height, p.x, p.y + obj.height - r);
      ctx.lineTo(p.x, p.y + r);
      ctx.quadraticCurveTo(p.x, p.y, p.x + r, p.y);
      ctx.closePath();
      ctx.fillStyle = obj.fill || '#475569';
      ctx.globalAlpha = obj.opacity || 1;
      ctx.fill();
      ctx.strokeStyle = obj.stroke || '#fff';
      ctx.lineWidth = obj.strokeWidth || 2;
      ctx.stroke();
      ctx.globalAlpha = 1;
    }

    if (obj.type === 'circle') {
      const p = worldToCanvas(obj.x, obj.y);
      ctx.beginPath();
      ctx.ellipse(p.x, p.y, obj.radius || 50, obj.radius || 50, 0, 0, Math.PI * 2);
      ctx.fillStyle = obj.fill || '#60a5fa';
      ctx.globalAlpha = obj.opacity || 1;
      ctx.fill();
      ctx.strokeStyle = obj.stroke || '#fff';
      ctx.lineWidth = obj.strokeWidth || 2;
      ctx.stroke();
      ctx.globalAlpha = 1;
    }

    if (obj.type === 'marker') {
      const p = worldToCanvas(obj.x, obj.y);
      const width = obj.width || 42;
      const height = obj.height || 42;
      ctx.beginPath();
      ctx.moveTo(p.x, p.y - height / 2);
      ctx.lineTo(p.x + width / 2, p.y);
      ctx.lineTo(p.x, p.y + height / 2);
      ctx.lineTo(p.x - width / 2, p.y);
      ctx.closePath();
      ctx.fillStyle = obj.fill || '#f59e0b';
      ctx.globalAlpha = obj.opacity || 1;
      ctx.fill();
      ctx.strokeStyle = obj.stroke || '#fff';
      ctx.lineWidth = obj.strokeWidth || 2;
      ctx.stroke();
      ctx.fillStyle = '#fff';
      ctx.font = '12px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(obj.label || 'M', p.x, p.y + 4);
      ctx.globalAlpha = 1;
    }
  });

  (mapData.markers || []).forEach((marker) => {
    const p = worldToCanvas(marker.x, marker.y);
    ctx.beginPath();
    ctx.fillStyle = marker.color || '#fbbf24';
    ctx.arc(p.x, p.y, 8, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#f8fafc';
    ctx.font = '11px sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText(marker.label || 'Mark', p.x + 14, p.y + 4);
  });

  (mapData.players || []).forEach((player) => {
    const p = worldToCanvas(player.x, player.y);
    ctx.beginPath();
    ctx.fillStyle = player.color || '#34d399';
    ctx.arc(p.x, p.y, 11, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = '#e2e8f0';
    ctx.font = '11px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(player.name || 'Player', p.x, p.y - 16);
  });
}

function renderPlayers(players) {
  playersList.innerHTML = '';

  players.forEach((player) => {
    const li = document.createElement('li');
    li.textContent = `${player.name} — ${player.active ? 'active' : 'idle'}`;
    playersList.appendChild(li);
  });
}

function renderMarkers(markers) {
  markersList.innerHTML = '';

  markers.forEach((marker) => {
    const li = document.createElement('li');
    li.textContent = `${marker.label} — ${marker.x}, ${marker.y}`;
    markersList.appendChild(li);
  });
}

async function refresh() {
  try {
    const response = await fetch('/api/maps/fortazan-kudo');
    const data = await response.json();
    renderMap(data);
    renderPlayers(data.players || []);
    renderMarkers(data.markers || []);
    sessionBadge.textContent = `Session: ${data.id}`;
  } catch (error) {
    console.error('Map load failed', error);
  }
}

refreshBtn.addEventListener('click', refresh);
refresh();
